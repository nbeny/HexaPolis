{
  "name": "hexapolis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "build:seq": "pnpm -r --workspace-concurrency=1 run build",
    "test:seq": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck:seq": "pnpm -r --workspace-concurrency=1 run typecheck",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @poligraph/db exec prisma migrate dev",
    "db:status": "node scripts/with-env.mjs pnpm --filter @poligraph/db exec prisma migrate status"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0"
  }
}
